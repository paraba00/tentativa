# Copie para .env. Nunca faça commit do .env.
# Exibe erros detalhados e habilita opções locais; em produção precisa ser false.
DJANGO_DEBUG=true
# Chave privada para assinaturas/sessões; init_env.py gera um valor imprevisível.
DJANGO_SECRET_KEY=
# Hosts aceitos no cabeçalho HTTP Host; acrescente o domínio real ao implantar.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Origens HTTPS confiáveis para CSRF, separadas por vírgula quando necessárias.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Oferece cadastro/senha de demonstração somente quando DEBUG também está ativo.
LOCAL_ACCOUNTS_ENABLED=true

# MySQL é o banco principal; sqlite é apenas alternativa explicitamente selecionada.
DB_ENGINE=mysql
# Nome do banco que receberá as tabelas das migrations.
DB_NAME=ouvidoria
# Usuário de banco usado pelo site, separado do administrador root.
DB_USER=ouvidoria
# Senha privada do usuário do site; o inicializador preenche no .env local.
DB_PASSWORD=
# Senha administrativa do MySQL; não é usada pelo site em operação normal.
DB_ROOT_PASSWORD=
# Host para execução fora do Docker; no Compose o serviço web sobrescreve para db.
DB_HOST=127.0.0.1
# Porta padrão de conexão do MySQL.
DB_PORT=3306
# Porta local do site; a porta interna do container continua sendo 8000.
WEB_PORT=8000

# Google Cloud: tipo Aplicativo da Web; URL autorizada de redirecionamento:
# http://localhost:8000/autenticacao/google/login/callback/
# Em produção use o endereço HTTPS real. Restrinja o app à organização.
# Identificador público do cliente OAuth autorizado pela instituição.
GOOGLE_CLIENT_ID=
# Segredo privado do cliente OAuth, necessário na troca do código por tokens.
GOOGLE_CLIENT_SECRET=

# Em desenvolvimento os links de confirmação aparecem nos logs, não na caixa postal.
# Console imprime mensagens; para SMTP real use django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Endereço do servidor SMTP caso a entrega real de mensagens seja ativada.
EMAIL_HOST=
# Porta usual de SMTP com STARTTLS; deve corresponder ao servidor escolhido.
EMAIL_PORT=587
# Usuário de autenticação do SMTP; não é a conta de login do aluno.
EMAIL_HOST_USER=
# Senha privada usada exclusivamente para autenticar no servidor de e-mail.
EMAIL_HOST_PASSWORD=
# Solicita conexão SMTP com STARTTLS, mantendo a validação do certificado.
EMAIL_USE_TLS=true
# Remetente padrão; o SMTP real precisa autorizar o uso deste endereço.
DEFAULT_FROM_EMAIL=ouvidoria@camporeal.edu.br
